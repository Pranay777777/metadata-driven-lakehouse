# Copy to .env and fill in. NEVER commit .env.
APP_ENV=local
LOG_LEVEL=INFO

# Control plane. Matches the docker compose stack — a credential that
# exists only in a local container. Anywhere else, leave DATABASE_URL
# alone and name the secret that holds the real URL instead (ADR-018).
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
# DATABASE_URL_SECRET=control-plane-url

# Secrets are resolved by name. 'env' reads variables like MASKING_KEY
# from here; 'keyvault' reads Azure Key Vault via managed identity and
# needs: pip install -e ".[azure]"
SECRETS_BACKEND=env
# KEY_VAULT_URL=https://<vault-name>.vault.azure.net

# Where Delta tables are written.
LAKE_ROOT=./lake

# Object storage is not part of the local stack yet (see ADR-011).
# Credentials are a secret name, never a value.
# S3_ENDPOINT_URL=
# S3_BUCKET=lakehouse
# S3_CREDENTIALS_SECRET=object-store-credentials

# Key for masking classified columns — the 'masking-key' secret under
# the env backend. Unset means the published development key, which
# protects nothing (ADR-017). In Key Vault a missing key is a hard error.
# MASKING_KEY=

# Lineage. Off by default; set true once `make up` is running.
OPENLINEAGE_ENABLED=false
OPENLINEAGE_URL=http://localhost:5000
OPENLINEAGE_NAMESPACE=lakehouse
MARQUEZ_WEB_URL=http://localhost:3000
