# Copy to .env and fill in. NEVER commit .env.
APP_ENV=local
LOG_LEVEL=INFO

# Control plane. Matches the docker compose stack.
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Where Delta tables are written.
LAKE_ROOT=./lake

# Object storage is not part of the local stack yet (see ADR-011).
# These are read at step 33, when the lake moves off local disk.
# S3_ENDPOINT_URL=
# S3_BUCKET=lakehouse

# Lineage. Off by default; set true once `make up` is running.
OPENLINEAGE_ENABLED=false
OPENLINEAGE_URL=http://localhost:5000
OPENLINEAGE_NAMESPACE=lakehouse
MARQUEZ_WEB_URL=http://localhost:3000
